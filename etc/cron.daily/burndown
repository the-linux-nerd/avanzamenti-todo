#!/bin/bash

GTOT=0
BASE=/var/www

. /etc/avanzamenti.conf

TODAY=$(date +%Y-%m-%d)

for i in "$BASE"/*; do
    [ -d "$i" ] || continue
    cd "$i" || continue

    if [ -f "TODO.md" ]; then
        TODO=$(grep -Ec '^- \[ \]' TODO.md)
        WAIT=$(grep -Ec '^- \[=\]' TODO.md)
        DEEP=$(grep -Ec '^- \[\?\]' TODO.md)

        # Le chiuse vivono in DONE.md: dal 08/09/2026 il TODO.md tiene solo il lavoro aperto e
        # le voci [v]/[x] traslocano nell'archivio. Contarle solo qui farebbe sparire tutto il
        # fatto il giorno della potatura, con un salto nella curva che non corrisponde a niente.
        # grep -c stampa comunque il numero ed esce 1 quando non trova nulla: un
        # '|| echo 0' qui concatenerebbe due valori e romperebbe l'espressione aritmetica
        DONE_ARCH=0
        DROP_ARCH=0
        if [ -f DONE.md ]; then
            DONE_ARCH=$(grep -Ec '^- \[v\]' DONE.md)
            DROP_ARCH=$(grep -Ec '^- \[x\]' DONE.md)
        fi
        DONE=$(( $(grep -Ec '^- \[v\]' TODO.md) + DONE_ARCH ))
        DROP=$(( $(grep -Ec '^- \[x\]' TODO.md) + DROP_ARCH ))

        # Dal 16/09/2026 il residuo e' [ ] + [=], e NON comprende piu' [?].
        # Il criterio e' "questo lavoro tornera'?": una [=] e' decisa e ferma solo perche' la
        # palla e' di un altro, quindi tornera' e resta nel residuo; una [?] non si sa nemmeno
        # se va fatta, e tenerla dentro faceva sembrare il progetto piu' carico di quello che e'.
        # ⚠ Il giorno in cui questo e' entrato in vigore la curva scende di uno scalino pari al
        # numero di [?] esistenti: e' il cambio di criterio, non lavoro chiuso.
        TOT=$((TODO + WAIT))

        PBARL=$((TOT / 5))
        PBAR=$(printf '%*s' "$PBARL" '' | tr ' ' '#')
        PTODAY=$(printf "%12s" "$TOT")

        # la riga si scrive SEMPRE, anche a zero: prima si saltava con "if TOT > 0"
        # e la serie di un progetto finito si interrompeva senza distinguersi da un
        # generatore fermo, proprio nel punto piu' significativo della curva
        #
        # il file puo' non esistere al primo giro di un progetto nuovo: senza questo
        # test sed -i fallirebbe e manderebbe una mail di cron a ogni esecuzione
        [ -f "$i/burndown.md" ] && sed -i "/^$TODAY/d" "$i/burndown.md"
        echo "$TODAY $PTODAY | $PBAR" >> "$i/burndown.md"

        GTOT=$((GTOT + TOT))
    fi
done

BARL=$((GTOT / 5))
BAR=$(printf '%*s' "$BARL" '' | tr ' ' '#')
TODAYTOT=$(printf "%12s" "$GTOT")

[ -f "$BASE/burndown.md" ] && sed -i "/^$TODAY/d" "$BASE/burndown.md"
echo "$TODAY $TODAYTOT | $BAR" >> "$BASE/burndown.md"
