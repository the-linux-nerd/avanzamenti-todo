#!/bin/bash

GTOT=0
BASE=/var/www
TODAY=$(date +%Y-%m-%d)

for i in "$BASE"/*; do
    [ -d "$i" ] || continue
    cd "$i" || continue

    if [ -f "TODO.md" ]; then
        TODO=$(grep -Ec '^- \[ \]' TODO.md)
        DONE=$(grep -Ec '^- \[v\]' TODO.md)
        DROP=$(grep -Ec '^- \[x\]' TODO.md)

        TOT=$TODO

        if [ "$TOT" -gt 0 ]; then
            PBARL=$((TOT / 5))
            PBAR=$(printf '%*s' "$PBARL" '' | tr ' ' '#')
            PTODAY=$(printf "%12s" "$TOT")

            sed -i "/^$TODAY/d" "$i/burndown.md"
            echo "$TODAY $PTODAY | $PBAR" >> "$i/burndown.md"

            GTOT=$((GTOT + TOT))
        fi
    fi
done

BARL=$((GTOT / 5))
BAR=$(printf '%*s' "$BARL" '' | tr ' ' '#')
TODAYTOT=$(printf "%12s" "$GTOT")

sed -i "/^$TODAY/d" "$BASE/burndown.md"
echo "$TODAY $TODAYTOT | $BAR" >> "$BASE/burndown.md"
